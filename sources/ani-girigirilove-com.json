{
  "factoryId": "rule",
  "version": 1,
  "arguments": {
    "name": "girigiri愛動漫",
    "description": "",
    "iconUrl": "https://girigirilove.com/app/app_files/anime.girigirilove.com_.png",
    "tier": 0,
    "channelTiers": {
      "简中": 0,
      "繁中": 1,
      "杜比": 6
    },
    "rule": {
      "baseUrl": "https://ani.girigirilove.com",
      "search": [
        {
          "op": "fetch",
          "url": "https://m3u8.girigirilove.com/api.php/Vod/get_list?vod_name={keyword}&limit=20&offset=0"
        },
        {
          "op": "jsonSubjects",
          "listPath": "info.rows",
          "idPath": "vod_id",
          "namePath": "vod_name",
          "urlTemplate": "https://ani.girigirilove.com/detail/{id}"
        }
      ],
      "detail": [
        {
          "op": "regex",
          "pattern": "/detail/(\\d+)"
        },
        {
          "op": "fetch",
          "url": "https://m3u8.girigirilove.com/api.php/Vod/get_detail?vod_id={value}"
        },
        {
          "op": "replace",
          "pattern": "(\"vod_play_from\":\"(?:[^\"]*?\\$\\$\\$)?)chs(?=\"|\\$\\$\\$)",
          "replacement": "$1简中"
        },
        {
          "op": "replace",
          "pattern": "(\"vod_play_from\":\"(?:[^\"]*?\\$\\$\\$)?)cht(?=\"|\\$\\$\\$)",
          "replacement": "$1繁中"
        },
        {
          "op": "maccmsEpisodes",
          "listPath": "info",
          "directOnly": true
        }
      ],
      "play": [],
      "matchEpisodeSortFromName": "第\\s*(?<ep>.+)\\s*[话集]",
      "defaultResolution": "1080P",
      "defaultSubtitleLanguage": "CHS",
      "matchVideo": {
        "enableNestedUrl": true,
        "matchNestedUrl": "^.+(vip|index\\.php).+\\?",
        "matchVideoUrl": "(^http(s)?:\\/\\/(?!.*http(s)?:\\/\\/).+((m3u8)).*(\\?.+)?)|(akamaized)|(bilivideo.com)|(url=(?<v>.+(playlist\\.m3u8|\\.mp4|\\.mkv)))",
        "cookies": "quality=1080P",
        "addHeadersToVideo": {
          "referer": "",
          "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/58.0.3029.110 Safari/537.3"
        }
      }
    }
  }
}
